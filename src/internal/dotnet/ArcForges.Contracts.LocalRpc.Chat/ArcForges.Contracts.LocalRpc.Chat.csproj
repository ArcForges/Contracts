<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>ArcForges.Contracts.LocalRpc.Chat</PackageId>
    <Version>1.0.0-ci.0.0</Version>
    <Description>Internal Chat contract records; no product listener or implementation.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <LicenceBoundary>Apache</LicenceBoundary>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ArcForges;protobuf;contracts</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <ProjectReference Include="../../../public/dotnet/ArcForges.Contracts.Foundation/ArcForges.Contracts.Foundation.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="$(ContractMetadataDir)/**/*" Pack="true" PackagePath="/" Condition="'$(ContractMetadataDir)' != ''" />
  </ItemGroup>
</Project>
