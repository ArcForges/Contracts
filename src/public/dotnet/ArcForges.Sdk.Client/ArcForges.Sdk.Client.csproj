<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>ArcForges.Sdk.Client</PackageId>
    <Version>1.0.0-ci.0.0</Version>
    <Description>Typed extension protocol calls over caller-owned transport.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <LicenceBoundary>Apache</LicenceBoundary>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ArcForges;protobuf;contracts</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.Core.Api" />
    <ProjectReference Include="../ArcForges.Sdk.Contracts/ArcForges.Sdk.Contracts.csproj" />
    <ProjectReference Include="../ArcForges.Contracts.Validation/ArcForges.Contracts.Validation.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="$(ContractMetadataDir)/**/*" Pack="true" PackagePath="/" Condition="'$(ContractMetadataDir)' != ''" />
  </ItemGroup>
</Project>
