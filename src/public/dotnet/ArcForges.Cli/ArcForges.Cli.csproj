<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>ArcForges.Cli</PackageId>
    <Version>1.0.0-ci.0.0</Version>
    <Description>Offline validation of the declared ArcForges package inventory.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <LicenceBoundary>Apache</LicenceBoundary>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ArcForges;protobuf;contracts</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
    <OutputType>Exe</OutputType>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>arcforges</ToolCommandName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ArcForges.Contracts.Validation/ArcForges.Contracts.Validation.csproj" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="$(ContractMetadataDir)/**/*" Pack="true" PackagePath="/" Condition="'$(ContractMetadataDir)' != ''" />
  </ItemGroup>
</Project>
