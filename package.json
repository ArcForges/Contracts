{
  "name": "arcforges-contracts-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=11.19.0 <12"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "src/internal/ts/ai-internal"
  ],
  "scripts": {
    "generate": "python eng/contracts.py generate",
    "generate:check": "python eng/contracts.py generate --check",
    "build": "npm run build --workspace @arcforges/ai-internal",
    "test": "npm run test:ai-internal",
    "test:ai-internal": "node --test tests/public/ai-internal.test.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "verify": "python eng/contracts.py verify-local"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "prettier": "3.9.8",
    "typescript": "7.0.2"
  },
  "arcforges": {
    "licenceBoundary": "Apache"
  }
}
