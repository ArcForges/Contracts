{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcforges.github.io/contracts/internal/identity/v1/provider-policy.schema.json",
  "title": "OperatorProviderPolicy",
  "x-arcforges-schema-version": "1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "realmId",
    "environment",
    "tenantId",
    "clientId",
    "accessApplicationId",
    "issuer",
    "operatorOrigin",
    "requiredAuthenticationContext",
    "policyIds",
    "supportedPolicyProjectionSha256",
    "sourceReference",
    "credentialVersion",
    "capturedAt",
    "notAfter"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "operator.provider-policy.v1"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-arcforges-max-utf8-bytes": 128,
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
    },
    "realmId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "environment": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "x-arcforges-max-utf8-bytes": 64,
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
    },
    "tenantId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "clientId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "accessApplicationId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "issuer": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "x-arcforges-max-utf8-bytes": 2048,
      "pattern": "^https://[^\\s]+$"
    },
    "operatorOrigin": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "x-arcforges-max-utf8-bytes": 2048,
      "pattern": "^https://[^\\s]+$"
    },
    "requiredAuthenticationContext": {
      "type": "string",
      "pattern": "^c([1-9]|[1-9][0-9])$",
      "maxLength": 3
    },
    "policyIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 36,
        "maxLength": 36,
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      }
    },
    "supportedPolicyProjectionSha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[\\x21-\\x7e]+$"
    },
    "credentialVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "x-arcforges-max-utf8-bytes": 128,
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
    },
    "capturedAt": {
      "type": "string",
      "minLength": 20,
      "maxLength": 30,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "notAfter": {
      "type": "string",
      "minLength": 20,
      "maxLength": 30,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    }
  },
  "x-arcforges-max-bytes": 65536,
  "x-arcforges-rules": ["operatorProviderPolicy"]
}
