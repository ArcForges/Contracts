{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "PartReceipt",
  "type": "object",
  "properties": {
    "partNumber": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "size": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$",
      "maxLength": 20,
      "x-arcforges-rules": ["uint64String"]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "etag": {
      "type": "string"
    }
  },
  "required": ["partNumber", "size", "sha256", "etag"],
  "additionalProperties": false,
  "x-arcforges-schema-version": "1"
}
