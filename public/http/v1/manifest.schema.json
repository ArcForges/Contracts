{
  "title": "ExtensionManifest",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "manifest.v1"
    },
    "packageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\\.[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "publisherId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
    },
    "signingKeyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
    },
    "name": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?:[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*|[ix]-(?:[A-Za-z0-9]{1,8})(?:-[A-Za-z0-9]{1,8})*)$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "minProperties": 1,
      "maxProperties": 16
    },
    "description": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?:[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*|[ix]-(?:[A-Za-z0-9]{1,8})(?:-[A-Za-z0-9]{1,8})*)$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "minProperties": 1,
      "maxProperties": 16
    },
    "platforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ManifestPlatform"
      },
      "minItems": 1
    },
    "contractRanges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ManifestContractRange"
      }
    },
    "contributions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ManifestContribution"
      },
      "minItems": 1,
      "maxItems": 256
    },
    "permissions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ManifestPermission"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ManifestDependency"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "executables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ManifestExecutable"
      }
    },
    "privateState": {
      "$ref": "#/$defs/ManifestPrivateState"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ManifestResource"
      }
    }
  },
  "required": [
    "schemaVersion",
    "packageId",
    "version",
    "publisherId",
    "signingKeyId",
    "name",
    "description",
    "platforms",
    "contractRanges",
    "contributions",
    "permissions",
    "dependencies",
    "executables",
    "resources"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: Apache-2.0; contracts08 sections1-3. Declared document shape and cross-field invariants only; archive bytes, trust, installed schemas and owner authorization remain separate.",
  "x-arcforges-max-bytes": 4194304,
  "x-arcforges-rules": [
    "manifestProfile"
  ],
  "$defs": {
    "ManifestResource": {
      "title": "ManifestResource",
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "licence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "path",
        "sha256",
        "licence"
      ],
      "additionalProperties": false
    },
    "ManifestContent": {
      "title": "ManifestContent",
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "schemaVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        }
      },
      "required": [
        "path",
        "sha256",
        "schemaVersion"
      ],
      "additionalProperties": false
    },
    "ManifestVersionRange": {
      "title": "ManifestVersionRange",
      "type": "object",
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "min": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "max": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        }
      },
      "required": [
        "major",
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "ManifestContractRange": {
      "title": "ManifestContractRange",
      "type": "object",
      "properties": {
        "packageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\\.[a-z][a-z0-9-]*$"
        },
        "range": {
          "$ref": "#/$defs/ManifestVersionRange"
        }
      },
      "required": [
        "packageId",
        "range"
      ],
      "additionalProperties": false
    },
    "ManifestDependency": {
      "title": "ManifestDependency",
      "type": "object",
      "properties": {
        "packageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*\\.[a-z][a-z0-9-]*$"
        },
        "range": {
          "$ref": "#/$defs/ManifestVersionRange"
        }
      },
      "required": [
        "packageId",
        "range"
      ],
      "additionalProperties": false
    },
    "ManifestPlatform": {
      "title": "ManifestPlatform",
      "type": "object",
      "properties": {
        "os": {
          "type": "string",
          "enum": [
            "windows",
            "linux",
            "macos",
            "android",
            "any"
          ]
        },
        "rid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        }
      },
      "required": [
        "os",
        "rid"
      ],
      "additionalProperties": false
    },
    "ManifestExecutable": {
      "title": "ManifestExecutable",
      "type": "object",
      "properties": {
        "rid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$"
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "runtimeIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
          }
        },
        "systemDependencyIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
          }
        }
      },
      "required": [
        "rid",
        "path",
        "sha256",
        "runtimeIds",
        "systemDependencyIds"
      ],
      "additionalProperties": false
    },
    "ManifestMigrationRange": {
      "title": "ManifestMigrationRange",
      "type": "object",
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false
    },
    "ManifestPrivateState": {
      "title": "ManifestPrivateState",
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        },
        "migrationRange": {
          "$ref": "#/$defs/ManifestMigrationRange"
        }
      },
      "required": [
        "schemaVersion",
        "maxBytes",
        "migrationRange"
      ],
      "additionalProperties": false
    },
    "ManifestCapabilityPermission": {
      "title": "ManifestCapabilityPermission",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "capability"
        },
        "reasonKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        }
      },
      "required": [
        "kind",
        "reasonKey",
        "operationId"
      ],
      "additionalProperties": false
    },
    "ManifestResourcePermission": {
      "title": "ManifestResourcePermission",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "resource"
        },
        "reasonKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "resourceKind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "access": {
          "type": "string",
          "enum": [
            "read",
            "write"
          ]
        }
      },
      "required": [
        "kind",
        "reasonKey",
        "resourceKind",
        "access"
      ],
      "additionalProperties": false
    },
    "ManifestNetworkPermission": {
      "title": "ManifestNetworkPermission",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "network"
        },
        "reasonKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "origins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^https://(?:[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*|\\[(?:(?:(?:[0-9A-Fa-f]{1,4}:){6}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|::(?:[0-9A-Fa-f]{1,4}:){0,5}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|(?:[0-9A-Fa-f]{1,4}:){0}[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}:){0,4}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|(?:[0-9A-Fa-f]{1,4}:){1}[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}:){0,3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|(?:[0-9A-Fa-f]{1,4}:){2}[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}:){0,2}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|(?:[0-9A-Fa-f]{1,4}:){3}[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}:){0,1}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3}|(?:[0-9A-Fa-f]{1,4}:){4}[0-9A-Fa-f]{1,4}::(?:[0-9A-Fa-f]{1,4}:){0,0}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])(?:\\.(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])){3})|([0-9A-Fa-f]{1,4}:){7}[0-9A-Fa-f]{1,4}|([0-9A-Fa-f]{1,4}:){1,7}:|([0-9A-Fa-f]{1,4}:){1,6}:[0-9A-Fa-f]{1,4}|([0-9A-Fa-f]{1,4}:){1,5}(:[0-9A-Fa-f]{1,4}){1,2}|([0-9A-Fa-f]{1,4}:){1,4}(:[0-9A-Fa-f]{1,4}){1,3}|([0-9A-Fa-f]{1,4}:){1,3}(:[0-9A-Fa-f]{1,4}){1,4}|([0-9A-Fa-f]{1,4}:){1,2}(:[0-9A-Fa-f]{1,4}){1,5}|[0-9A-Fa-f]{1,4}:((:[0-9A-Fa-f]{1,4}){1,6})|:((:[0-9A-Fa-f]{1,4}){1,7}|:))\\])(?::(?:6553[0-5]|655[0-2][0-9]|65[0-4][0-9]{2}|6[0-4][0-9]{3}|[1-5][0-9]{4}|[1-9][0-9]{0,3}))?$"
          },
          "minItems": 1
        }
      },
      "required": [
        "kind",
        "reasonKey",
        "origins"
      ],
      "additionalProperties": false
    },
    "ManifestBackgroundPermission": {
      "title": "ManifestBackgroundPermission",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "background"
        },
        "reasonKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "reasonKey",
        "enabled"
      ],
      "additionalProperties": false
    },
    "ManifestPermission": {
      "title": "ManifestPermission",
      "oneOf": [
        {
          "$ref": "#/$defs/ManifestCapabilityPermission"
        },
        {
          "$ref": "#/$defs/ManifestResourcePermission"
        },
        {
          "$ref": "#/$defs/ManifestNetworkPermission"
        },
        {
          "$ref": "#/$defs/ManifestBackgroundPermission"
        }
      ]
    },
    "ManifestResourceRef": {
      "title": "ManifestResourceRef",
      "type": "object",
      "properties": {
        "realmId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": [
            "nonzeroUuid"
          ]
        },
        "workspaceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": [
            "nonzeroUuid"
          ]
        },
        "ownerAppId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
        },
        "resourceKind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
        },
        "resourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": [
            "nonzeroUuid"
          ]
        },
        "displayHint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "availability": {
          "type": "string",
          "enum": [
            "AlwaysKeep",
            "AvailableOffline",
            "OnDemand",
            "CloudOnly",
            "MissingExternal"
          ]
        },
        "holdingDeviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": [
            "nonzeroUuid"
          ]
        }
      },
      "required": [
        "realmId",
        "ownerAppId",
        "resourceKind",
        "resourceId",
        "availability"
      ],
      "additionalProperties": false
    },
    "ManifestTextValue": {
      "title": "ManifestTextValue",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "text"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "ManifestBoolValue": {
      "title": "ManifestBoolValue",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "bool"
        },
        "value": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "ManifestInt64Value": {
      "title": "ManifestInt64Value",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "int64"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|-[1-9][0-9]*|[1-9][0-9]*)$",
          "x-arcforges-rules": [
            "int64"
          ]
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "ManifestDecimalValue": {
      "title": "ManifestDecimalValue",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "decimal"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 39,
          "pattern": "^(0|-?[1-9][0-9]*|-?(0|[1-9][0-9]*)\\.[0-9]{0,8}[1-9])$",
          "x-arcforges-rules": [
            "canonicalDecimal"
          ]
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "ManifestEnumValue": {
      "title": "ManifestEnumValue",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "enum"
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "ManifestResourceRefValue": {
      "title": "ManifestResourceRefValue",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "resourceRef"
        },
        "value": {
          "$ref": "#/$defs/ManifestResourceRef"
        }
      },
