{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "BrowserSession",
  "description": "Closed same-origin browser session exceptions under /session/v1: strict JSON bodies mirroring the numbered Identity records as precise-value projections, plus the OIDC provider callback query. Shape validity is not authentication, CSRF, origin or flow-state authorization.",
  "oneOf": [
    {
      "$ref": "#/$defs/BrowserBootstrapResponse"
    },
    {
      "$ref": "#/$defs/BrowserBeginAuthenticationRequest"
    },
    {
      "$ref": "#/$defs/BrowserCompleteAuthenticationRequest"
    },
    {
      "$ref": "#/$defs/BrowserCompleteEnrollmentRequest"
    },
    {
      "$ref": "#/$defs/BrowserBeginRecoveryRequest"
    },
    {
      "$ref": "#/$defs/BrowserCompleteRecoveryRequest"
    },
    {
      "$ref": "#/$defs/BrowserBeginStepUpRequest"
    },
    {
      "$ref": "#/$defs/BrowserCompleteStepUpRequest"
    },
    {
      "$ref": "#/$defs/BrowserAuthChallenge"
    },
    {
      "$ref": "#/$defs/BrowserSessionView"
    },
    {
      "$ref": "#/$defs/BrowserStepUpEvidence"
    },
    {
      "$ref": "#/$defs/BrowserReceipt"
    },
    {
      "$ref": "#/$defs/BrowserOidcCallbackSuccess"
    },
    {
      "$ref": "#/$defs/BrowserOidcCallbackFailure"
    }
  ],
  "$defs": {
    "BrowserInstallationClaim": {
      "title": "BrowserInstallationClaim",
      "type": "object",
      "properties": {
        "installationId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": ["nonzeroUuid"]
        },
        "product": {
          "type": "string",
          "enum": ["arcscope", "companion"]
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "appVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        }
      },
      "required": ["installationId", "product", "platform", "appVersion"],
      "additionalProperties": false
    },
    "BrowserWebAuthnOptions": {
      "title": "BrowserWebAuthnOptions",
      "type": "object",
      "properties": {
        "rpId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "userHandle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 86,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
        },
        "allowedCredentials": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 1364,
            "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
          },
          "maxItems": 64
        },
        "excludedCredentials": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 1364,
            "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
          },
          "maxItems": 64
        },
        "userVerification": {
          "type": "string",
          "const": "required"
        },
        "algorithms": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [-7]
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": ["rpId", "userVerification", "algorithms"],
      "additionalProperties": false
    },
    "BrowserWebAuthnAssertion": {
      "title": "BrowserWebAuthnAssertion",
      "type": "object",
      "properties": {
        "credentialId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1364,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
        },
        "clientDataJson": {
          "type": "string",
          "minLength": 2,
          "maxLength": 21846,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
        },
        "authenticatorData": {
          "type": "string",
          "minLength": 2,
          "maxLength": 21846,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
        },
        "signature": {
          "type": "string",
          "minLength": 2,
          "maxLength": 342,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
        },
        "userHandle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 86,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
        }
      },
      "required": ["credentialId", "clientDataJson", "authenticatorData", "signature"],
      "additionalProperties": false
    },
    "BrowserWebAuthnCreation": {
      "title": "BrowserWebAuthnCreation",
      "type": "object",
      "properties": {
        "credentialId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1364,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
        },
        "clientDataJson": {
          "type": "string",
          "minLength": 2,
          "maxLength": 21846,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
        },
        "attestationObject": {
          "type": "string",
          "minLength": 2,
          "maxLength": 21846,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
        },
        "transports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
          },
          "maxItems": 8
        }
      },
      "required": ["credentialId", "clientDataJson", "attestationObject"],
      "additionalProperties": false
    },
    "BrowserAuthProofPasskey": {
      "title": "BrowserAuthProofPasskey",
      "type": "object",
      "properties": {
        "passkey": {
          "$ref": "#/$defs/BrowserWebAuthnAssertion"
        }
      },
      "required": ["passkey"],
      "additionalProperties": false
    },
    "BrowserAuthProofEmailCode": {
      "title": "BrowserAuthProofEmailCode",
      "type": "object",
      "properties": {
        "emailCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-arcforges-max-utf8-bytes": 8192
        }
      },
      "required": ["emailCode"],
      "additionalProperties": false
    },
    "BrowserAuthProofRecoveryCode": {
      "title": "BrowserAuthProofRecoveryCode",
      "type": "object",
      "properties": {
        "recoveryCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-arcforges-max-utf8-bytes": 8192
        }
      },
      "required": ["recoveryCode"],
      "additionalProperties": false
    },
    "BrowserAuthProofPassword": {
      "title": "BrowserAuthProofPassword",
      "type": "object",
      "properties": {
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-arcforges-max-utf8-bytes": 8192
        }
      },
      "required": ["password"],
      "additionalProperties": false
    },
    "BrowserAuthProofProviderReceipt": {
      "title": "BrowserAuthProofProviderReceipt",
      "type": "object",
      "properties": {
        "providerReceipt": {
          "type": "string",
          "minLength": 1,
          "x-arcforges-max-utf8-bytes": 8192
        }
      },
      "required": ["providerReceipt"],
      "additionalProperties": false
    },
    "BrowserAuthProofAdminGrant": {
      "title": "BrowserAuthProofAdminGrant",
      "type": "object",
      "properties": {
        "adminGrant": {
          "type": "string",
          "minLength": 1,
          "x-arcforges-max-utf8-bytes": 8192
        }
      },
      "required": ["adminGrant"],
      "additionalProperties": false
    },
    "BrowserAuthProof": {
      "title": "BrowserAuthProof",
      "oneOf": [
        {
          "$ref": "#/$defs/BrowserAuthProofPasskey"
        },
        {
          "$ref": "#/$defs/BrowserAuthProofEmailCode"
        },
        {
          "$ref": "#/$defs/BrowserAuthProofRecoveryCode"
        },
        {
          "$ref": "#/$defs/BrowserAuthProofPassword"
        },
        {
          "$ref": "#/$defs/BrowserAuthProofProviderReceipt"
        },
        {
          "$ref": "#/$defs/BrowserAuthProofAdminGrant"
        }
      ]
    },
    "BrowserEnrollmentProofEmailCode": {
      "title": "BrowserEnrollmentProofEmailCode",
      "type": "object",
      "properties": {
        "emailCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-arcforges-max-utf8-bytes": 8192
        }
      },
      "required": ["emailCode"],
      "additionalProperties": false
    },
    "BrowserEnrollmentProofLocalCode": {
      "title": "BrowserEnrollmentProofLocalCode",
      "type": "object",
      "properties": {
        "localCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-arcforges-max-utf8-bytes": 8192
        }
      },
      "required": ["localCode"],
      "additionalProperties": false
    },
    "BrowserEnrollmentProofProviderReceipt": {
      "title": "BrowserEnrollmentProofProviderReceipt",
      "type": "object",
      "properties": {
        "providerReceipt": {
          "type": "string",
          "minLength": 1,
          "x-arcforges-max-utf8-bytes": 8192
        }
      },
      "required": ["providerReceipt"],
      "additionalProperties": false
    },
    "BrowserEnrollmentProof": {
      "title": "BrowserEnrollmentProof",
      "oneOf": [
        {
          "$ref": "#/$defs/BrowserEnrollmentProofEmailCode"
        },
        {
          "$ref": "#/$defs/BrowserEnrollmentProofLocalCode"
        },
        {
          "$ref": "#/$defs/BrowserEnrollmentProofProviderReceipt"
        }
      ]
    },
    "BrowserCredentialReplacementPasskey": {
      "title": "BrowserCredentialReplacementPasskey",
      "type": "object",
      "properties": {
        "passkey": {
          "$ref": "#/$defs/BrowserWebAuthnCreation"
        }
      },
      "required": ["passkey"],
      "additionalProperties": false
    },
    "BrowserCredentialReplacementPassword": {
      "title": "BrowserCredentialReplacementPassword",
      "type": "object",
      "properties": {
        "password": {
          "type": "string",
          "minLength": 15,
          "maxLength": 128,
          "x-arcforges-max-utf8-bytes": 8192
        }
      },
      "required": ["password"],
      "additionalProperties": false
    },
    "BrowserCredentialReplacement": {
      "title": "BrowserCredentialReplacement",
      "oneOf": [
        {
          "$ref": "#/$defs/BrowserCredentialReplacementPasskey"
        },
        {
          "$ref": "#/$defs/BrowserCredentialReplacementPassword"
        }
      ]
    },
    "BrowserResourceRef": {
      "title": "BrowserResourceRef",
      "type": "object",
      "properties": {
        "realmId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": ["nonzeroUuid"]
        },
        "workspaceId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": ["nonzeroUuid"]
        },
        "ownerAppId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "resourceKind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "resourceId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": ["nonzeroUuid"]
        },
        "displayHint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "availability": {
          "type": "string",
          "enum": ["alwaysKeep", "availableOffline", "onDemand", "cloudOnly", "missingExternal"]
        },
        "holdingDeviceId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": ["nonzeroUuid"]
        }
      },
      "required": ["realmId", "ownerAppId", "resourceKind", "resourceId", "availability"],
      "additionalProperties": false
    },
    "BrowserBlobRef": {
      "title": "BrowserBlobRef",
      "type": "object",
      "properties": {
        "blobId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": ["nonzeroUuid"]
        },
        "contentHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "sizeBytes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]*)$",
          "x-arcforges-rules": ["uint64String"]
        }
      },
      "required": ["blobId", "contentHash", "sizeBytes"],
      "additionalProperties": false
    },
    "BrowserAvatarCloud": {
      "title": "BrowserAvatarCloud",
      "type": "object",
      "properties": {
        "resource": {
          "$ref": "#/$defs/BrowserResourceRef"
        },
        "contentHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "blob": {
          "$ref": "#/$defs/BrowserBlobRef"
        },
        "cloud": {
          "type": "string",
          "minLength": 1,
          "maxLength": 19,
          "pattern": "^[1-9][0-9]*$",
          "x-arcforges-rules": ["positiveInt64String"]
        }
      },
      "required": ["resource", "cloud"],
      "additionalProperties": false
    },
    "BrowserAvatarNative": {
      "title": "BrowserAvatarNative",
      "type": "object",
      "properties": {
        "resource": {
          "$ref": "#/$defs/BrowserResourceRef"
        },
        "contentHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "blob": {
          "$ref": "#/$defs/BrowserBlobRef"
        },
        "native": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]*)$",
          "x-arcforges-rules": ["uint64String"]
        }
      },
      "required": ["resource", "native"],
      "additionalProperties": false
    },
    "BrowserAvatarRef": {
      "title": "BrowserAvatarRef",
      "oneOf": [
        {
          "$ref": "#/$defs/BrowserAvatarCloud"
        },
        {
          "$ref": "#/$defs/BrowserAvatarNative"
        }
      ]
    },
    "BrowserProfileUpdateKeepAvatar": {
      "title": "BrowserProfileUpdateKeepAvatar",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "locale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "BrowserProfileUpdateSetAvatar": {
      "title": "BrowserProfileUpdateSetAvatar",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "locale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "avatar": {
          "$ref": "#/$defs/BrowserAvatarRef"
        }
      },
      "required": ["avatar"],
      "additionalProperties": false
    },
    "BrowserProfileUpdateClearAvatar": {
      "title": "BrowserProfileUpdateClearAvatar",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "locale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "clearAvatar": {
          "type": "boolean",
          "const": true
        }
      },
      "required": ["clearAvatar"],
      "additionalProperties": false
    },
    "BrowserProfileUpdate": {
      "title": "BrowserProfileUpdate",
      "oneOf": [
        {
          "$ref": "#/$defs/BrowserProfileUpdateKeepAvatar"
        },
        {
          "$ref": "#/$defs/BrowserProfileUpdateSetAvatar"
        },
        {
          "$ref": "#/$defs/BrowserProfileUpdateClearAvatar"
        }
      ]
    },
    "BrowserSessionProjection": {
      "title": "BrowserSessionProjection",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": ["nonzeroUuid"]
        },
        "expiresAt": {
          "type": "string",
          "minLength": 20,
          "maxLength": 30,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "idleExpiresAt": {
          "type": "string",
          "minLength": 20,
          "maxLength": 30,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "userId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": ["nonzeroUuid"]
        },
        "deviceId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": ["nonzeroUuid"]
        },
        "workspaceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "x-arcforges-rules": ["nonzeroUuid"]
          },
          "maxItems": 100
        },
        "recoveryGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]*)$",
          "x-arcforges-rules": ["uint64String"]
        },
        "purpose": {
          "type": "string",
          "enum": ["authenticate", "enroll", "stepUp", "recover", "cancelDeletion"]
        }
      },
      "required": [
        "sessionId",
        "expiresAt",
        "userId",
        "deviceId",
        "workspaceIds",
        "recoveryGeneration",
        "purpose"
      ],
      "additionalProperties": false
    },
    "BrowserProfileProjection": {
      "title": "BrowserProfileProjection",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "locale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 19,
          "pattern": "^[1-9][0-9]*$",
          "x-arcforges-rules": ["positiveInt64String"]
        }
      },
      "required": ["displayName", "locale", "timezone", "revision"],
      "additionalProperties": false
    },
    "BrowserBootstrapResponse": {
      "title": "BrowserBootstrapResponse",
      "type": "object",
      "properties": {
        "csrfToken": {
          "type": "string",
          "minLength": 16,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "authenticated": {
          "type": "boolean"
        },
        "session": {
          "$ref": "#/$defs/BrowserSessionProjection"
        },
        "profile": {
          "$ref": "#/$defs/BrowserProfileProjection"
        }
      },
      "required": ["csrfToken", "authenticated"],
      "additionalProperties": false,
      "x-arcforges-max-bytes": 16384
    },
    "BrowserBeginAuthenticationRequest": {
      "title": "BrowserBeginAuthenticationRequest",
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": ["passkey", "email", "password", "oidc"]
        },
        "loginHint": {
          "type": "string",
