          "maxLength": 21846,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
        },
        "attestationObject": {
          "type": "string",
          "minLength": 2,
          "maxLength": 21846,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
        },
        "transports": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
          },
          "maxItems": 8
        }
      },
      "required": ["credentialId", "clientDataJson", "attestationObject"],
      "additionalProperties": false
    },
    "WebBrowserAuthProofPasskey": {
      "title": "WebBrowserAuthProofPasskey",
      "type": "object",
