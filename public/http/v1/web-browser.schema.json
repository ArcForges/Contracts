        }
      ]
    },
    "WebBrowserSessionProjection": {
      "title": "WebBrowserSessionProjection",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": ["nonzeroUuid"]
        },
        "expiresAt": {
          "type": "string",
          "minLength": 20,
          "maxLength": 30,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "idleExpiresAt": {
          "type": "string",
          "minLength": 20,
          "maxLength": 30,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
        },
        "userId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": ["nonzeroUuid"]
        },
        "deviceId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": ["nonzeroUuid"]
        },
        "workspaceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
            "x-arcforges-rules": ["nonzeroUuid"]
          },
          "maxItems": 100
        },
        "recoveryGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]*)$",
          "x-arcforges-rules": ["uint64String"]
        },
        "purpose": {
          "type": "string",
          "enum": ["authenticate", "enroll", "stepUp", "recover", "cancelDeletion"]
        }
      },
      "required": [
        "sessionId",
        "expiresAt",
        "userId",
        "deviceId",
        "workspaceIds",
        "recoveryGeneration",
        "purpose"
      ],
      "additionalProperties": false
    },
