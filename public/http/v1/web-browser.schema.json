{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "WebBrowserSession",
  "description": "Closed same-origin browser session exceptions of an arcforges-web installation under /session/v1/web (AF-CTR-03; ArcForges-Design AD-0021 section 7): the meaning of the BrowserSession document (public/http/v1/browser.schema.json, frozen by the CON.17 later-services window) with its own definitions and routes, whose installation claim also admits the arcforges-web product. Strict JSON bodies mirroring the numbered Identity records as precise-value projections, plus the OIDC provider callback query. Shape validity is not authentication, CSRF, origin or flow-state authorization.",
  "oneOf": [
    {
      "$ref": "#/$defs/WebBrowserBootstrapResponse"
    },
    {
      "$ref": "#/$defs/WebBrowserBeginAuthenticationRequest"
    },
    {
      "$ref": "#/$defs/WebBrowserCompleteAuthenticationRequest"
    },
    {
      "$ref": "#/$defs/WebBrowserCompleteEnrollmentRequest"
    },
    {
      "$ref": "#/$defs/WebBrowserBeginRecoveryRequest"
    },
    {
      "$ref": "#/$defs/WebBrowserCompleteRecoveryRequest"
    },
    {
      "$ref": "#/$defs/WebBrowserBeginStepUpRequest"
    },
    {
      "$ref": "#/$defs/WebBrowserCompleteStepUpRequest"
    },
    {
      "$ref": "#/$defs/WebBrowserAuthChallenge"
    },
    {
      "$ref": "#/$defs/WebBrowserSessionView"
    },
    {
      "$ref": "#/$defs/WebBrowserStepUpEvidence"
    },
    {
      "$ref": "#/$defs/WebBrowserReceipt"
    },
    {
      "$ref": "#/$defs/WebBrowserOidcCallbackSuccess"
    },
    {
      "$ref": "#/$defs/WebBrowserOidcCallbackFailure"
    }
  ],
  "$defs": {
    "WebBrowserInstallationClaim": {
      "title": "WebBrowserInstallationClaim",
      "type": "object",
      "properties": {
        "installationId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": ["nonzeroUuid"]
        },
        "product": {
          "type": "string",
          "enum": ["arcscope", "companion", "arcforges-web"]
        },
        "platform": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "appVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        }
      },
      "required": ["installationId", "product", "platform", "appVersion"],
      "additionalProperties": false
    },
    "WebBrowserWebAuthnOptions": {
      "title": "WebBrowserWebAuthnOptions",
      "type": "object",
      "properties": {
        "rpId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "userHandle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 86,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
        },
        "allowedCredentials": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 1364,
            "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
          },
          "maxItems": 64
        },
        "excludedCredentials": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 2,
            "maxLength": 1364,
            "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
          },
          "maxItems": 64
        },
        "userVerification": {
          "type": "string",
          "const": "required"
        },
        "algorithms": {
          "type": "array",
          "items": {
            "type": "integer",
            "enum": [-7]
          },
          "minItems": 1,
          "maxItems": 1
        }
      },
      "required": ["rpId", "userVerification", "algorithms"],
      "additionalProperties": false
    },
    "WebBrowserWebAuthnAssertion": {
      "title": "WebBrowserWebAuthnAssertion",
      "type": "object",
      "properties": {
        "credentialId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1364,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
        },
        "clientDataJson": {
          "type": "string",
          "minLength": 2,
          "maxLength": 21846,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
        },
        "authenticatorData": {
          "type": "string",
          "minLength": 2,
          "maxLength": 21846,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
        },
        "signature": {
          "type": "string",
          "minLength": 2,
          "maxLength": 342,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
        },
        "userHandle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 86,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
        }
      },
      "required": ["credentialId", "clientDataJson", "authenticatorData", "signature"],
      "additionalProperties": false
    },
    "WebBrowserWebAuthnCreation": {
      "title": "WebBrowserWebAuthnCreation",
      "type": "object",
      "properties": {
        "credentialId": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1364,
          "pattern": "^(?:[A-Za-z0-9_-]{4})*(?:[A-Za-z0-9_-]{2,3})?$"
        },
        "clientDataJson": {
          "type": "string",
