          "x-arcforges-rules": ["nonzeroUuid"]
        },
        "workspaceId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": ["nonzeroUuid"]
        },
        "ownerAppId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "resourceKind": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
        },
        "resourceId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": ["nonzeroUuid"]
        },
        "displayHint": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "availability": {
          "type": "string",
          "enum": ["alwaysKeep", "availableOffline", "onDemand", "cloudOnly", "missingExternal"]
        },
        "holdingDeviceId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": ["nonzeroUuid"]
        }
      },
      "required": ["realmId", "ownerAppId", "resourceKind", "resourceId", "availability"],
      "additionalProperties": false
    },
    "WebBrowserBlobRef": {
      "title": "WebBrowserBlobRef",
      "type": "object",
      "properties": {
        "blobId": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "x-arcforges-rules": ["nonzeroUuid"]
        },
        "contentHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "sizeBytes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]*)$",
          "x-arcforges-rules": ["uint64String"]
        }
      },
      "required": ["blobId", "contentHash", "sizeBytes"],
      "additionalProperties": false
    },
    "WebBrowserAvatarCloud": {
      "title": "WebBrowserAvatarCloud",
      "type": "object",
      "properties": {
        "resource": {
          "$ref": "#/$defs/WebBrowserResourceRef"
        },
        "contentHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "blob": {
          "$ref": "#/$defs/WebBrowserBlobRef"
        },
        "cloud": {
          "type": "string",
          "minLength": 1,
          "maxLength": 19,
          "pattern": "^[1-9][0-9]*$",
          "x-arcforges-rules": ["positiveInt64String"]
        }
