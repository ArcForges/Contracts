          "type": "string",
          "minLength": 1,
          "x-arcforges-max-utf8-bytes": 8192
        }
      },
      "required": ["providerReceipt"],
      "additionalProperties": false
    },
    "WebBrowserEnrollmentProof": {
      "title": "WebBrowserEnrollmentProof",
      "oneOf": [
        {
          "$ref": "#/$defs/WebBrowserEnrollmentProofEmailCode"
        },
