      "required": ["emailCode"],
      "additionalProperties": false
    },
    "WebBrowserAuthProofRecoveryCode": {
      "title": "WebBrowserAuthProofRecoveryCode",
      "type": "object",
      "properties": {
        "recoveryCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-arcforges-max-utf8-bytes": 8192
        }
      },
      "required": ["recoveryCode"],
      "additionalProperties": false
    },
    "WebBrowserAuthProofPassword": {
      "title": "WebBrowserAuthProofPassword",
      "type": "object",
      "properties": {
        "password": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-arcforges-max-utf8-bytes": 8192
        }
      },
      "required": ["password"],
      "additionalProperties": false
    },
    "WebBrowserAuthProofProviderReceipt": {
      "title": "WebBrowserAuthProofProviderReceipt",
      "type": "object",
      "properties": {
        "providerReceipt": {
          "type": "string",
          "minLength": 1,
          "x-arcforges-max-utf8-bytes": 8192
        }
      },
      "required": ["providerReceipt"],
      "additionalProperties": false
    },
    "WebBrowserAuthProofAdminGrant": {
      "title": "WebBrowserAuthProofAdminGrant",
      "type": "object",
      "properties": {
        "adminGrant": {
          "type": "string",
          "minLength": 1,
          "x-arcforges-max-utf8-bytes": 8192
        }
      },
      "required": ["adminGrant"],
      "additionalProperties": false
    },
    "WebBrowserAuthProof": {
      "title": "WebBrowserAuthProof",
      "oneOf": [
        {
          "$ref": "#/$defs/WebBrowserAuthProofPasskey"
        },
        {
          "$ref": "#/$defs/WebBrowserAuthProofEmailCode"
        },
        {
          "$ref": "#/$defs/WebBrowserAuthProofRecoveryCode"
        },
        {
          "$ref": "#/$defs/WebBrowserAuthProofPassword"
        },
        {
          "$ref": "#/$defs/WebBrowserAuthProofProviderReceipt"
        },
        {
          "$ref": "#/$defs/WebBrowserAuthProofAdminGrant"
        }
      ]
    },
    "WebBrowserEnrollmentProofEmailCode": {
      "title": "WebBrowserEnrollmentProofEmailCode",
      "type": "object",
      "properties": {
        "emailCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "x-arcforges-max-utf8-bytes": 8192
        }
