  "identityChain": [
    {
      "obligation": "userSession",
      "status": "bound",
      "requires": [
        {
          "producer": "cloud",
          "check": "references",
          "table": "identity_session",
          "reference": "user_id>identity_user"
        },
        {
          "producer": "platform",
          "check": "pointStep",
          "point": "TransportBoundary",
          "step": "ActorIdentity"
        },
        {
          "producer": "platform",
          "check": "pointStep",
          "point": "ServiceDecision",
          "step": "ActorIdentity"
        }
      ]
    },
    {
      "obligation": "workspaceOwner",
      "status": "bound",
      "requires": [
        {
          "producer": "cloud",
          "check": "references",
          "table": "workspace_workspace",
          "reference": "owner_user_id>identity_user"
        },
        {
          "producer": "cloud",
          "check": "unique",
          "table": "workspace_workspace",
          "columns": "realm_id+owner_user_id"
        },
        {
          "producer": "platform",
          "check": "pointStep",
          "point": "ServiceDecision",
          "step": "ScopeValid"
        }
      ]
    },
    {
      "obligation": "currentPermission",
      "status": "bound",
      "requires": [
        {
          "producer": "platform",
          "check": "pointStep",
          "point": "ServiceDecision",
          "step": "CapabilityPermission"
        },
        {
          "producer": "platform",
          "check": "pointStep",
          "point": "OwnerFinalValidation",
          "step": "OwnerValidation"
        }
      ]
    },
    {
      "obligation": "currentServiceEligibility",
      "status": "declared-port",
      "requires": [
        {
          "producer": "platform",
          "check": "pointStep",
          "point": "OwnerFinalValidation",
          "step": "OwnerValidation"
        }
      ],
      "limit": "The owner validates last and again on execution, but eligibility is a fact the host owner validator supplies through a port; no producer declares an eligibility source or a production implementation of that port yet."
    },
    {
      "obligation": "recheckAtTrigger",
      "status": "pending-producer",
      "requires": [],
      "reason": "No producer has declared an automation trigger that re-evaluates its owner; the pinned Platform pipeline runs when a request is made and the automation lifecycle is not delivered."
    },
    {
      "obligation": "explicitProvisioning",
      "status": "pending-producer",
      "requires": [],
      "reason": "No producer has declared a deployment-service provisioning record; the pinned enrollment family provisions a user workspace, not a deployment service."
    },
    {
      "obligation": "separateOperatorIdentity",
      "status": "bound",
      "requires": [
        {
          "producer": "cloud",
          "check": "tableExists",
          "table": "identity_operator_session"
        },
        {
          "producer": "cloud",
          "check": "tableExists",
          "table": "identity_operator_access"
        },
        {
          "producer": "cloud",
          "check": "noReferenceTo",
          "table": "identity_operator_session",
          "target": "identity_user"
        },
        {
          "producer": "cloud",
          "check": "noReferenceTo",
          "table": "identity_operator_access",
          "target": "identity_user"
        }
      ]
    }
  ],
  "limits": [
    "Operation classification and the producer facts are declared metadata: no operation handler, store or enforcement point is bound to any operation here, and every classified operation reports behavior not-bound.",
    "Producer facts are an exact-commit snapshot re-derived only by an explicit local run against a producer checkout; the Cloud and DesktopPlatform packages published today carry no machine-readable declaration of these facts.",
    "Cloud declares the schema, ownership relations and eight plans of the identity module; session, device, api-token and flow behavior belongs to later producer tasks, so those classifications rest on their declared tables only.",
    "Platform declares the decision pipeline and its four enforcement points; owner permission, product policy, trust and eligibility facts are ports with no production source."
  ]
}
