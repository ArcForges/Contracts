  "evidenceClass": "offline schema, guard and error vectors only; no deployed Container, Worker, D1, SQL plan, authorization or live-service proof",
  "encoding": {
    "arguments": "Ordered outer entries map to the fixed statement order in the registered named plan; each inner array contains that statement's ordered typed parameters. No statement text, table name or client-selected operation is accepted.",
    "scalars": "Every D1 scalar is tagged; int64, uint64 and decimal use canonical strings; bytes use unpadded base64url; SQLite JSON text remains a text scalar for the typed plan consumer.",
    "ownerScope": "Opaque bounded nonempty route binding only; trusted Container identity, active deployment generation and owner authorization remain mandatory server-side checks. The field alone never grants or proves authority.",
    "unknownOutcome": "After an ambiguous timeout, reconcile by the same requestId and receipt; do not retry with a new requestId or assume no effect."
  },
