      "effects": false
    },
    {
      "id": "constraint-refusal-is-typed",
      "guard": "owner-revision-lease-generation-constraints",
      "input": { "requestId": "40000000-0000-4000-8000-000000000153" },
      "outcome": "constraint",
      "effects": false
    },
    {
      "id": "ambiguous-timeout-remains-unknown",
      "guard": "receipt-lookup-after-unknown-outcome",
      "input": { "requestId": "40000000-0000-4000-8000-000000000154" },
      "outcome": "unknownOutcome",
      "retryRequestId": "40000000-0000-4000-8000-000000000154",
      "newEffectPermitted": false
    },
    {
      "id": "untrusted-container-or-public-ingress-refused",
      "guard": "private-container-identity-and-no-public-route",
      "input": { "publicRoute": true, "trustedContainer": false },
      "outcome": "refuse-before-plan-execution",
      "effects": false
    }
  ]
}
