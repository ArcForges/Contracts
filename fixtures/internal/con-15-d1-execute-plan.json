      "effects": false
    },
    {
      "id": "unsupported-plan-version",
      "guard": "mutually-supported-plan-manifest",
      "input": { "planId": "task.claim.v1", "planVersion": 2 },
      "outcome": "invalidPlan",
      "effects": false
    },
    {
      "id": "manifest-hash-mismatch",
      "guard": "exact-plan-manifest-hash",
