        "committedAt": { "unixSeconds": "1790593200", "nanos": 500000000 },
        "rawCaptureBytesPresent": false
      }
    },
    {
      "id": "get-session-unresolved-parent-is-not-reassigned-or-exposed",
      "operationId": "scope.getSession",
      "source": {
